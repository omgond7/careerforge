# =============================================================================
# CareerForge AI — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/careerforge"

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret-here"

# App base URL (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Encryption Key (Must be 32 bytes/characters)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY="your-32-byte-secret-key-here"

# ─── Upstash QStash ───────────────────────────────────────────────────────────
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ─── OAuth Providers ──────────────────────────────────────────────────────────
# Google OAuth — https://console.developers.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── AI (Gemini + OpenRouter) ─────────────────────────────────────────────────
# Primary: Google Gemini 2.5 Flash — https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Fallback: OpenRouter DeepSeek — https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="deepseek/deepseek-chat"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL (used for rate limiting and AI response caching)
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (S3 / Cloudflare R2) ─────────────────────────────────────
# Credentials and bucket configuration for resume file storage (AWS S3 or Cloudflare R2)
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_REGION="us-east-1"
S3_BUCKET="careerforge-resumes"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com" # Required for Cloudflare R2, optional for AWS S3
S3_PUBLIC_URL="https://your-bucket.s3.amazonaws.com" # Public base URL for stored files (no trailing slash)

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Used for verification emails and password resets
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="CareerForge <no-reply@careerforge.ai>"
